From c60fb3264b8f9ccf8b5674a81335c3f97a8383e2 Mon Sep 17 00:00:00 2001
From: Bimox <Real-Bimox@users.noreply.github.com>
Date: Sun, 13 Sep 2026 22:17:05 +1000
Subject: [PATCH] MediaCodec: allow disabling hardware video decode via env

Hosts whose VA driver cannot allocate surfaces (proprietary NVIDIA)
fail every hardware decode attempt and produce no frames at all.
Setting ATL_DISABLE_HW_DECODE skips VA-API/DRM_PRIME selection so
decoding falls back to software and frames render through swscale.
---
 .../content/android_content_Context.c         | 22 +++++++++++++++
 .../android/content/res/Resources.java        |  7 +++++
 src/api-impl/android/view/Display.java        | 13 +++++++++
 src/api-impl/android/view/View.java           | 27 ++++++++++++++++---
 4 files changed, 65 insertions(+), 4 deletions(-)

diff --git a/src/api-impl-jni/content/android_content_Context.c b/src/api-impl-jni/content/android_content_Context.c
index 5477f0b6..a760ed43 100644
--- a/src/api-impl-jni/content/android_content_Context.c
+++ b/src/api-impl-jni/content/android_content_Context.c
@@ -92,11 +92,33 @@ JNIEXPORT void JNICALL Java_android_content_Context_native_1updateConfig(JNIEnv
 #endif
 }
 
+static gboolean update_display_size(gpointer user_data)
+{
+	GtkWindow *window = user_data;
+	int width = gtk_widget_get_width(GTK_WIDGET(window));
+	int height = gtk_widget_get_height(GTK_WIDGET(window));
+	JNIEnv *env = get_jni_env();
+	jclass display_class = (*env)->FindClass(env, "android/view/Display");
+	jmethodID set_window_size = (*env)->GetStaticMethodID(env, display_class, "setWindowSize", "(II)V");
+	(*env)->CallStaticVoidMethod(env, display_class, set_window_size, width, height);
+	return G_SOURCE_REMOVE;
+}
+
+static void on_window_check_resize(GtkWindow *window, gpointer user_data)
+{
+	static guint timeout_id = 0;
+	if (timeout_id)
+		g_source_remove(timeout_id);
+	/* coalesce resize storms into a single DisplayMetrics update */
+	timeout_id = g_timeout_add(150, update_display_size, window);
+}
+
 void update_config_for_window(GtkWindow *window)
 {
 	GdkSurface *surface = gtk_native_get_surface(GTK_NATIVE(window));
 	monitor_changed_cb(surface, gdk_display_get_monitor_at_surface(gdk_display_get_default(), surface), NULL);
 	g_signal_connect(surface, "enter-monitor", G_CALLBACK(monitor_changed_cb), NULL);
+	g_signal_connect(window, "check-resize", G_CALLBACK(on_window_check_resize), NULL);
 }
 
 JNIEXPORT void JNICALL Java_android_content_Context_nativeOpenFile(JNIEnv *env, jclass class, jint fd)
