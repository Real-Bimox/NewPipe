+		}
+	}
+
 	public static Resources getSystem() {
 		Resources ret = mSystem;
 		if (ret != null) {
diff --git a/src/api-impl/android/view/Display.java b/src/api-impl/android/view/Display.java
index 97b2343d..ad6f5644 100644
--- a/src/api-impl/android/view/Display.java
+++ b/src/api-impl/android/view/Display.java
@@ -1,5 +1,7 @@
 package android.view;
 
+import android.content.res.Resources;
+
 import android.graphics.Point;
 import android.graphics.Rect;
 import android.util.DisplayMetrics;
@@ -9,6 +11,17 @@ public final class Display {
 	public static int window_width = 960;
 	public static int window_height = 540;
 
+	/**
+	 * Called from native code when the window is resized, so that apps
+	 * observe the current window size through DisplayMetrics instead of the
+	 * size the window had at startup.
+	 */
+	public static void setWindowSize(int width, int height) {
+		window_width = width;
+		window_height = height;
+		Resources.onWindowSizeChanged(width, height);
+	}
+
 	// FIXME: what do we return here?
 	// we don't want to hardcode this stuff, but at the same time the apps can cache it
 	public void getMetrics(DisplayMetrics outMetrics) {
diff --git a/src/api-impl/android/view/View.java b/src/api-impl/android/view/View.java
index 9fa596aa..43e8ebf2 100644
--- a/src/api-impl/android/view/View.java
+++ b/src/api-impl/android/view/View.java
@@ -1,5 +1,7 @@
 package android.view;
 
+import java.util.concurrent.CopyOnWriteArrayList;
+
 import android.R;
 import android.animation.AnimatorInflater;
 import android.animation.StateListAnimator;
@@ -719,7 +721,8 @@ public class View implements Drawable.Callback {
 	}
 
 	public interface OnLayoutChangeListener {
-		// TODO
+		void onLayoutChange(View v, int left, int top, int right, int bottom,
+				int oldLeft, int oldTop, int oldRight, int oldBottom);
 	}
 
 	public interface OnUnhandledKeyEventListener {
@@ -1651,8 +1654,10 @@ public class View implements Drawable.Callback {
 			measure(width | MeasureSpec.EXACTLY, height | MeasureSpec.EXACTLY);
 		}
 		boolean changed = oldWidth != width || oldHeight != height;
-		if (changed)
+		if (changed) {
 			onSizeChanged(width, height, oldWidth, oldHeight);
+			dispatchOnLayoutChange(width, height, oldWidth, oldHeight);
+		}
 		bottom = top + height;
 		right = left + width;
 		onLayout(changed, 0, 0, width, height);
@@ -1773,8 +1778,22 @@ public class View implements Drawable.Callback {
 		return tag;
 	}
 
-	public void addOnLayoutChangeListener(OnLayoutChangeListener listener) {}
-	public void removeOnLayoutChangeListener(OnLayoutChangeListener listener) {}
+	private final CopyOnWriteArrayList<OnLayoutChangeListener> onLayoutChangeListeners = new CopyOnWriteArrayList<>();
+
+	public void addOnLayoutChangeListener(OnLayoutChangeListener listener) {
+		onLayoutChangeListeners.add(listener);
+	}
+
+	public void removeOnLayoutChangeListener(OnLayoutChangeListener listener) {
+		onLayoutChangeListeners.remove(listener);
+	}
+
+	private void dispatchOnLayoutChange(int width, int height, int oldWidth, int oldHeight) {
+		for (OnLayoutChangeListener listener : onLayoutChangeListeners) {
+			listener.onLayoutChange(this, left, top, left + width, top + height,
+					left, top, left + oldWidth, top + oldHeight);
+		}
+	}
 
 	public boolean isSelected() { return false; }
 
